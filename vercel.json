{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "pnpm run build",
  "installCommand": "pnpm install --frozen-lockfile",
  "builds": [
    {
      "src": "dist/vercel-entry.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60,
        "includeFiles": "dist/public/**"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/dist/vercel-entry.js"
    }
  ]
}
