# انسخ هذا الملف مرجعاً للقيم المطلوبة في Vercel (Production + Preview).
# لا تضع القيم الحقيقية داخل Git.

# --- Supabase (المصادقة) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# مطلوب فقط إن أردت صلاحيات إدارية من الخادم (server/supabase.ts)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# بريد المالك (اختياري)
SUPABASE_ADMIN_EMAIL=

# --- الجلسات ---
# سر عشوائي طويل خاص بالمتجر، وليس سر Supabase
JWT_SECRET=

# --- قاعدة بيانات المتجر ---
# المشروع يستخدم drizzle-orm/mysql2 + dialect "mysql"، والرابط يجب أن يكون MySQL.
# TiDB Serverless يمنح رابطاً بهذه الصيغة مباشرة (انسخه من لوحة TiDB Cloud):
DATABASE_URL=mysql://USER:PASSWORD@gateway-XX.REGION.prod.aws.tidbcloud.com:4000/DBNAME

# ملاحظات مهمة:
# - استخدم المنفذ 3000 (TCP غير مشفّر) في TiDB Serverless.
#   المنفذ 4000 يفرض TLS، وmysql2 في هذا المشروع يُستدعى بلا إعدادات SSL
#   (server/db.ts -> drizzle(url))، فلن ينجح الاتصال عبر 4000 دون تعديل الكود.
# - رابط TiDB يأتي بصيغة mysql:// مباشرة، فلا حاجة لأي تحويل.
# - بعد ضبط القيمة شغّل: pnpm run db:push

# --- OAuth (اختياري، لا يلزم إن لم تُستخدم الميزة) ---
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=
