# انسخ هذا الملف مرجعاً للقيم المطلوبة في Vercel (Production + Preview).
# لا تضع القيم الحقيقية داخل Git.

# --- Supabase (المصادقة) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# مطلوب فقط إن أردت صلاحيات إدارية من الخادم (server/supabase.ts)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# بريد المالك (اختياري)
SUPABASE_ADMIN_EMAIL=

# --- الجلسات ---
# سر عشوائي طويل خاص بالمتجر، وليس سر Supabase
JWT_SECRET=

# --- قاعدة بيانات المتجر ---
# المشروع يستخدم drizzle-orm/mysql2، أي أن الرابط يجب أن يكون MySQL.
# أمثلة مجانية/مناسبة: TiDB Cloud Serverless.
DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/DB

# --- OAuth (اختياري، لا يلزم إن لم تُستخدم الميزة) ---
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=
